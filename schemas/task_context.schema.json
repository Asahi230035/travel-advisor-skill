{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TravelTaskContext",
  "type": "object",
  "required": [
    "task_id",
    "scope",
    "requested_outputs"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "discover",
        "verify",
        "compare",
        "budget",
        "plan",
        "audit",
        "revise"
      ]
    },
    "user_goal": {
      "type": "string"
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "known": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "strength"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "strength": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "source": {
            "enum": [
              "explicit",
              "inferred",
              "assumed"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorized_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "related_session_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
