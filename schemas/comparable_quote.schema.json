{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comparable hotel quote (runtime contract)",
  "description": "A quote provided to travel_core.compare; the agent must independently check any real-world facts.",
  "type": "object",
  "required": ["checkin", "checkout", "guests", "rooms", "room_type", "currency", "all_in_price", "price_basis", "taxes_included", "mandatory_fees_included", "breakfast", "cancellation", "membership_required", "payment_terms"],
  "properties": {
    "checkin": {"type": "string", "format": "date"},
    "checkout": {"type": "string", "format": "date"},
    "guests": {"type": "integer", "minimum": 1},
    "rooms": {"type": "integer", "minimum": 1},
    "room_type": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "all_in_price": {"type": "number", "minimum": 0},
    "price_basis": {"const": "all_in_total"},
    "taxes_included": {"const": true},
    "mandatory_fees_included": {"const": true},
    "breakfast": {"type": "string", "minLength": 1},
    "cancellation": {"type": "string", "minLength": 1},
    "membership_required": {"type": "boolean"},
    "payment_terms": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "source_url": {"type": ["string", "null"], "format": "uri"}
  },
  "additionalProperties": true
}
